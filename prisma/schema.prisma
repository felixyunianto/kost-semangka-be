// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  role Role

  fullName String  @map("full_name") @db.VarChar(150)
  phone    String? @db.VarChar(30)

  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  properties          Property[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  expiredAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  challengeId    String    @unique
  otpHash        String
  resetTokenHash String?
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  lastResentAt   DateTime?
  expiredAt      DateTime
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Property {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid

  name        String  @db.VarChar(150)
  description String? @db.Text
  address     String  @db.Text
  phone       String? @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rooms          Room[]
  setting        PropertySetting?
  financeEntries FinanceEntry[]

  @@index([ownerId])
  @@index([name])
  @@map("properties")
}

enum LateFeeType {
  FIXED
  PERCENTAGE
}

model PropertySetting {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @unique @db.Uuid

  lateFeeEnabled   Boolean     @default(false) @map("late_fee_enabled")
  lateFeeType      LateFeeType @default(FIXED) @map("late_fee_type")
  lateFeeAmount    Decimal     @default(0) @map("late_fee_amount") @db.Decimal(12, 2)
  lateFeeGraceDays Int         @default(0) @map("late_fee_grace_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_settings")
}

enum RentalType {
  MONTHLY
  DAILY
}

enum InventoryCondition {
  GOOD
  FAIR
  POOR
}

enum InventoryStatus {
  FUNCTIONAL
  REPAIRING
}

model Room {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid

  name        String  @db.VarChar(100)
  description String? @db.Text

  price Decimal @db.Decimal(12, 2)

  rentalType RentalType @default(MONTHLY) @map("rental_type")

  isAvailable Boolean @default(true) @map("is_available")

  type String? @db.VarChar(50)

  length Decimal? @db.Decimal(5, 2)
  width  Decimal? @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  occupants   Occupant[]
  inventories RoomInventory[]

  @@index([propertyId])
  @@index([isAvailable])
  @@map("rooms")
}

model RoomInventory {
  id     String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid

  name      String              @db.VarChar(100)
  condition InventoryCondition
  status    InventoryStatus     @default(FUNCTIONAL)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status])
  @@index([condition])
  @@map("room_inventories")
}

model Occupant {
  id String @id @default(uuid()) @db.Uuid

  roomId String @db.Uuid

  fullName String  @map("full_name") @db.VarChar(150)
  email    String  @db.VarChar(225)
  phone    String? @db.VarChar(30)

  checkIn  DateTime  @map("check_in")
  checkOut DateTime? @map("check_out")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  room Room @relation(fields: [roomId], references: [id])

  bills Bill[]

  @@index([roomId])
  @@index([isActive])
  @@index([checkIn])
  @@index([checkOut])
  @@map("occupants")
}

enum BillType {
  RENT
  MANUAL
  BOOKING
}

enum BillStatus {
  UNPAID
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Bill {
  id String @id @default(uuid()) @db.Uuid

  occupantId String? @db.Uuid
  bookingId  String? @db.Uuid

  invoiceNumber String @unique @map("invoice_number") @db.VarChar(50)

  type BillType

  amount        Decimal @db.Decimal(12, 2)
  lateFeeAmount Decimal @default(0) @map("late_fee_amount") @db.Decimal(12, 2)

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  dueDate DateTime? @map("due_date") @db.Date

  description String? @db.VarChar(255)

  status BillStatus @default(UNPAID)

  paidAt DateTime? @map("paid_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  occupant Occupant? @relation(fields: [occupantId], references: [id])

  // nanti:
  // booking Booking? @relation(...)

  payment Payment?

  @@unique([occupantId, type, periodStart, periodEnd])
  @@index([occupantId])
  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@map("bills")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  billId String @unique @db.Uuid
  bill   Bill   @relation(fields: [billId], references: [id])

  gateway          PaymentGateway
  gatewayReference String?        @unique
  payToken         String         @unique @map("pay_token") @db.VarChar(64)

  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  paymentUrl String?
  qrCode     String?

  vaNumber   String? @map("va_number")
  bankName   String? @map("bank_name")

  expiredAt     DateTime?
  paidAt        DateTime?
  lastChargedAt DateTime? @map("last_charged_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges PaymentCharge[]

  @@index([status])
  @@index([gateway])
  @@map("payments")
}

enum PaymentChargeStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  SUPERSEDED
}

model PaymentCharge {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid

  gatewayReference String @unique @map("gateway_reference")

  amount Decimal @db.Decimal(12, 2)

  qrCode    String?
  expiredAt DateTime? @map("expired_at")

  status PaymentChargeStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_charges")
}

enum PaymentGateway {
  MIDTRANS
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum FinanceCategory {
  MAINTENANCE
  SALARY
  OTHER
}

model FinanceEntry {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid

  type        FinanceType
  category    FinanceCategory
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime        @map("occurred_at") @db.Date
  description String          @db.VarChar(255)
  notes       String?         @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([type])
  @@index([category])
  @@index([occurredAt])
  @@map("finance_entries")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}
